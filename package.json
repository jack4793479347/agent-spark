{
  "name": "agentspark",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "dev:web": "turbo dev --filter=@agentspark/web",
    "dev:api": "turbo dev --filter=@agentspark/api",
    "build:web": "turbo build --filter=@agentspark/web",
    "build:api": "turbo build --filter=@agentspark/api"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.0.0",
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.11.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.9.155"
  }
}
